{
  "$defs": {
    "ReplaceItem": {
      "type": "object",
      "title": "ReplaceItem",
      "properties": {
        "slot": {
          "type": "string",
          "enum": [
            "outer",
            "top",
            "bottom",
            "shoes",
            "socks",
            "accessories"
          ],
          "title": "Slot"
        },
        "item_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Item Name"
        }
      },
      "additionalProperties": false,
      "required": [
        "slot",
        "item_name"
      ]
    }
  },
