ANTHROPIC_API_KEY=
# 코디 생성(outfit_generation)은 thinking={"type": "disabled"}로 호출한다. claude-sonnet-5 기준 값이라
# 생성 모델을 바꾸면 400으로 추천이 전부 폴백된다 (Sonnet 5.5는 "between_tools"로 바꿔야 함)
# LLM_DEFAULT_MODEL=claude-sonnet-5
# 용도(call_name)별 모델 덮어쓰기 (JSON)
# LLM_MODEL_OVERRIDES={"image_tagging": "claude-haiku-4-5"}
# LLM_MAX_ATTEMPTS=3
# LLM_BACKOFF_BASE_S=0.5
# LLM_BACKOFF_MAX_S=8
# 2차 검증(리뷰어) 모델. LLM_MODEL_OVERRIDES의 outfit_review 키는 효과 없음
# temperature=0으로 호출하므로 기본값 아닌 temperature를 받는 모델만 넣을 수 있다 (claude-sonnet-5 등은 400)
# LLM_REVIEWER_MODEL=claude-haiku-4-5
