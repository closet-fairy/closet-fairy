# REGENERATION_FEELS_LIKE_STEP=3.0
# REGENERATION_FEELS_LIKE_MAX_STEPS=2
# REGENERATION_REQUEST_MAX_LENGTH=300
# REGENERATION_PROCESSING_TIMEOUT_SECONDS=180
# REGENERATION_INTENT_TIMEOUT_S=10
# REGENERATION_INTENT_MAX_ATTEMPTS=2
# REGENERATION_INTENT_MAX_RETRY_WAIT_S=2

# SESSION_ABANDON_TIMEOUT_MINUTES=

# MEDIA_ROOT=media
# MEDIA_URL_PREFIX=/media
# CLOTHING_UPLOAD_MAX_FILES=20
# CLOTHING_UPLOAD_MAX_BYTES=20971520
# CLOTHING_IMAGE_WEBP_QUALITY=90
# CLOTHING_IMAGE_MAX_PIXELS=50000000
# CLOTHING_IMAGE_NORMALIZE_CONCURRENCY=4
# CLOTHING_REQUEST_LIMIT_PER_MINUTE=10

# BG_REMOVAL_ENABLED=true
# 배경 제거 모델. rembg 모델 이름을 그대로 쓴다. bria-rmbg는 상업적 사용 불가라 고르지 않는다
# BG_REMOVAL_MODEL=isnet-general-use
# 마스크 후처리. 끄면 경계는 부드럽지만 어두운 옷이 반투명하게 남는다
# BG_REMOVAL_POST_PROCESS_MASK=true
# 누끼를 만들기 전 긴 변을 이 크기로 줄인다. 결과 파일 크기와 추론 메모리·시간의 상한
# BG_REMOVAL_MAX_SIDE=2048
# 동시에 돌릴 추론 수. onnxruntime이 이미 코어를 나눠 쓰므로 CPU에서는 1을 권장
# BG_REMOVAL_CONCURRENCY=1
# BG_REMOVAL_POLL_INTERVAL_S=2.0

# AUTO_TAGGING_ENABLED=true
# 자동 태깅 모델. LLM_MODEL_OVERRIDES의 clothing_tagging 키는 효과 없음
# temperature=0으로 부르므로 temperature를 받는 모델만 쓴다. claude-sonnet-5 계열은 400으로 거절한다
# AUTO_TAGGING_MODEL=claude-haiku-4-5
# AUTO_TAGGING_IMAGE_MAX_SIDE=1024
# AUTO_TAGGING_TIMEOUT_S=60
# AUTO_TAGGING_CONCURRENCY=2
# AUTO_TAGGING_POLL_INTERVAL_S=2.0

MYSQL_ROOT_PASSWORD=dev

ANTHROPIC_API_KEY=
# 코디 생성(outfit_generation)은 thinking={"type": "disabled"}로 호출한다. claude-sonnet-5 기준 값이라
# 생성 모델을 바꾸면 400으로 추천이 전부 폴백된다 (Sonnet 5.5는 "between_tools"로 바꿔야 함)
# LLM_DEFAULT_MODEL=claude-sonnet-5
# 용도(call_name)별 모델 덮어쓰기 (JSON)
# LLM_MODEL_OVERRIDES={"outfit_generation": "claude-haiku-4-5"}
# LLM_MAX_ATTEMPTS=3
# LLM_BACKOFF_BASE_S=0.5
# LLM_BACKOFF_MAX_S=8
# 2차 검증(리뷰어) 모델. LLM_MODEL_OVERRIDES의 outfit_review 키는 효과 없음
# temperature=0으로 호출하므로 기본값 아닌 temperature를 받는 모델만 넣을 수 있다 (claude-sonnet-5 등은 400)
# LLM_REVIEWER_MODEL=claude-haiku-4-5
# 재추천 의도 파싱 모델. LLM_MODEL_OVERRIDES의 regeneration_intent 키는 효과 없음
# temperature=0으로 호출하므로 temperature를 거절하는 모델(claude-sonnet-5 등)은 넣지 말 것 (400)
# LLM_INTENT_MODEL=claude-haiku-4-5
